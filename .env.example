GEMINI_API_KEY=your_gemini_api_key_here
PORT=5000

# Postgres connection string. Format: postgres://user:password@host:port/database
# For a local install: postgres://postgres:your_password@localhost:5432/drivewell
DATABASE_URL=postgres://postgres:your_password@localhost:5432/drivewell

# Shared passcode fleet managers enter to view driver risk dashboards.
# This is a simple shared-secret gate, not per-manager accounts — replace with
# real auth before a wider rollout.
MANAGER_PASSCODE=choose_a_strong_passcode
